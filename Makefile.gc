#---------------------------------------------------------------------------------
# Clear the implicit built in rules
#---------------------------------------------------------------------------------
.SUFFIXES:
#---------------------------------------------------------------------------------
ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment. export DEVKITPPC=<path to>devkitPPC")
endif

#include $(DEVKITPPC)/wii_rules
include $(DEVKITPRO)/libogc2/gamecube_rules

#---------------------------------------------------------------------------------
# TARGET is the name of the output
# BUILD is the directory where object files & intermediate files will be placed
# SOURCES is a list of directories containing source code
# INCLUDES is a list of directories containing extra header files
#---------------------------------------------------------------------------------
MPLAYER		:=	$(CURDIR)/source/mplayer
TARGET		:=	wiimc
BUILD		:=	build
SOURCES		:=	source source/libwiigui source/utils source/utils/unzip \
				source/images source/lang source/fonts
INCLUDES	:=	source source/mplayer

#---------------------------------------------------------------------------------
# options for code generation
#---------------------------------------------------------------------------------

# Compile settings, NTFS = 191KB, EXT2 = 91KB, Full = 282KB
ENABLE_NTFS                   = 0
ENABLE_EXT2                   = 0

ENABLE_WIIMOTE                = 0
ENABLE_SMB                    = 0
ENABLE_3DS                    = 0

# Log file, crash report and hang diagnostics on sd1:/wiimc.log.
# See source/utils/debuglog.c and PORTING.md section 11.
ENABLE_DEBUGLOG               = 1


CFLAGS		=	-g -O2 -Wall $(MACHDEP) $(INCLUDE)  \
				-D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -Wframe-larger-than=8192
CXXFLAGS	=	$(CFLAGS)
LDFLAGS		=	-g $(MACHDEP) -Wl,-wrap,memcpy

#---------------------------------------------------------------------------------
# any extra libraries we wish to link with the project
#---------------------------------------------------------------------------------
LIBS    := -lmplayerwii -lavformat -lavcodec -lswscale -lavutil \
                        -ljpeg -liconv -lpng -lz \
                        -lfat -logc -lfreetype -lmxml -lexif \
                        -lbrotlidec -lbrotlicommon -lbz2

ifeq ($(ENABLE_NTFS), 1)
CFLAGS += -DWANT_NTFS
LIBS += -lntfs
endif

ifeq ($(ENABLE_EXT2), 1)
CFLAGS += -DWANT_EXT2
LIBS += -lext2fs
endif

ifeq ($(ENABLE_WIIMOTE), 1)
CFLAGS += -DWANT_WIIMOTE
LIBS += -lwiiuse
LIBS += -lbte
endif

ifeq ($(ENABLE_SMB), 1)
CFLAGS += -DWANT_SMB
LIBS += -ltinysmb
endif

ifeq ($(ENABLE_3DS), 1)
CFLAGS += -DWANT_3DS
endif

# Every wrap below is a call from one object file to a symbol defined in
# another, which is the only kind --wrap can intercept. The exception handler
# one is how the crash report gets in: libogc's assembly vector routine calls
# c_default_exceptionhandler after saving the frame.
ifeq ($(ENABLE_DEBUGLOG), 1)
CFLAGS += -DWANT_DEBUGLOG -DWIIMC_BUILD_ID=\"$(BUILD_ID)\"
LDFLAGS += -Wl,--wrap=c_default_exceptionhandler \
           -Wl,--wrap=exit -Wl,--wrap=abort -Wl,--wrap=__assert_func \
           -Wl,--wrap=malloc -Wl,--wrap=calloc -Wl,--wrap=realloc -Wl,--wrap=memalign \
           -Wl,--wrap=LWP_CreateThread
endif

#---------------------------------------------------------------------------------
# list of directories containing libraries, this must be the top level containing
# include and lib
#---------------------------------------------------------------------------------
LIBDIRS	:= $(PORTLIBS)


#---------------------------------------------------------------------------------
# no real need to edit anything past this point unless you need to add additional
# rules for different file extensions
#---------------------------------------------------------------------------------
ifneq ($(BUILD),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export OUTPUT	:=	$(CURDIR)/$(TARGETDIR)/$(TARGET)
export VPATH	:=	$(foreach dir,$(SOURCES),$(CURDIR)/$(dir))
export DEPSDIR	:=	$(CURDIR)/$(BUILD)

#---------------------------------------------------------------------------------
# automatically build a list of object files for our project
#---------------------------------------------------------------------------------
CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
sFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
SFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.S)))
TTFFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.ttf)))
LANGFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.lang)))
PNGFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.png)))
JPGFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.jpg)))

#---------------------------------------------------------------------------------
# use CXX for linking C++ projects, CC for standard C
#---------------------------------------------------------------------------------
ifeq ($(strip $(CPPFILES)),)
	export LD	:=	$(CC)
else
	export LD	:=	$(CXX)
endif

export OFILES	:=	$(CPPFILES:.cpp=.o) $(CFILES:.c=.o) \
					$(sFILES:.s=.o) $(SFILES:.S=.o) \
					$(TTFFILES:.ttf=.ttf.o) $(LANGFILES:.lang=.lang.o) \
					$(PNGFILES:.png=.png.o) $(JPGFILES:.jpg=.jpg.o)
					#$(CURDIR)/source/utils/ehcmodule.elf.o
#---------------------------------------------------------------------------------
# build a list of include paths
#---------------------------------------------------------------------------------
export INCLUDE	:=	$(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
					$(foreach dir,$(LIBDIRS),-I$(dir)/include) \
					-I$(CURDIR)/$(BUILD) \
					-I$(LIBOGC_INC) $(foreach dir,$(LIBDIRS),-I$(dir)/include/freetype2)

#---------------------------------------------------------------------------------
# build a list of library paths
#---------------------------------------------------------------------------------
 
export LIBPATHS	:=	$(foreach dir,$(LIBDIRS),-L$(dir)/lib) \
					-L$(LIBOGC_LIB) \
				-L$(MPLAYER)/ \
				-L$(MPLAYER)/ffmpeg/libavcodec \
				-L$(MPLAYER)/ffmpeg/libavformat \
				-L$(MPLAYER)/ffmpeg/libavutil \
				-L$(MPLAYER)/ffmpeg/libswscale 

export OUTPUT	:=	$(CURDIR)/$(TARGET)
.PHONY: $(BUILD) clean deploy

#---------------------------------------------------------------------------------
# Every build is deployed to the SD card when it is plugged in.
#
# SDCARD is the card as MSYS2 sees it (F: is /f). A drive only counts as the
# card if it already has apps/wiimc/, so a different removable drive on the
# same letter is never written to. Override with: make -f Makefile.gc SDCARD=/g
#
# BUILD_ID names the build in three places that must agree: the header of
# sd1:/wiimc.log, the ELF archived in deployed/, and the make output. It is
# ?= so that the sub-makes below inherit the value rather than re-reading the
# clock.
#---------------------------------------------------------------------------------
SDCARD			?=	/f
export BUILD_ID	?=	$(shell date +%Y%m%d-%H%M%S)
DEPLOY_KEEP		:=	8

$(BUILD):
	cd source/mplayer; $(MAKE) -f Makefile; cd ../..
	@[ -d $@ ] || mkdir -p $@
	@rm -f $(BUILD)/debuglog.o
	@make --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile.gc
	@make --no-print-directory -f $(CURDIR)/Makefile.gc deploy

deploy:
	@if [ ! -d "$(SDCARD)/apps/wiimc" ]; then \
		echo "deploy: no card at $(SDCARD) (no apps/wiimc/), skipped"; \
		exit 0; \
	fi; \
	mkdir -p logs deployed; \
	for f in wiimc.log wiimc-prev.log wiimc-crash.txt wiimc-crash-prev.txt; do \
		[ -f "$(SDCARD)/$$f" ] || continue; \
		base="logs/$$(date -r "$(SDCARD)/$$f" +%Y%m%d-%H%M%S)-$$f"; \
		dst="$$base"; n=2; \
		while [ -f "$$dst" ] && [ "$$(md5sum < "$(SDCARD)/$$f")" != "$$(md5sum < "$$dst")" ]; do \
			dst="$${base%.*}-$$n.$${base##*.}"; n=$$((n+1)); \
		done; \
		if [ -f "$$dst" ]; then \
			echo "deploy: $$f already fetched as $$dst"; \
		else \
			cp -p "$(SDCARD)/$$f" "$$dst" || continue; \
			echo "deploy: fetched $$dst"; \
		fi; \
		rm -f "$(SDCARD)/$$f" && echo "deploy: removed $$f from the card"; \
	done; \
	sync; \
	cp $(OUTPUT).dol "$(SDCARD)/$(TARGET).dol" && sync; \
	[ "$$(md5sum < $(OUTPUT).dol)" = "$$(md5sum < "$(SDCARD)/$(TARGET).dol")" ] || \
		{ echo "deploy: FAILED, $(SDCARD)/$(TARGET).dol differs from the build"; exit 1; }; \
	id=$$(grep -ao 'boot trace, build [0-9]*-[0-9]*' $(OUTPUT).dol | head -n 1 | sed 's/.* //'); \
	[ -n "$$id" ] || id=unknown-$(BUILD_ID); \
	[ -f "deployed/$(TARGET)-$$id.elf" ] || cp $(OUTPUT).elf "deployed/$(TARGET)-$$id.elf"; \
	ls -1t deployed/$(TARGET)-*.elf | tail -n +$$(( $(DEPLOY_KEEP) + 1 )) | xargs -r rm -f; \
	echo "deploy: $(TARGET).dol -> $(SDCARD)/ (build $$id, elf in deployed/)"

#---------------------------------------------------------------------------------
test:
	@make --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile


clean:
	@echo clean ...
	rm -f $(BUILD)/*.d $(BUILD)/*.h $(BUILD)/*.ii $(BUILD)/*.lst $(BUILD)/*.map \
	$(BUILD)/*.o $(BUILD)/*.s
	@rm -fr $(OUTPUT).elf $(OUTPUT).dol
	cd source/mplayer; $(MAKE) -f Makefile clean

#---------------------------------------------------------------------------------
run:
	wiiload $(OUTPUT).dol

#---------------------------------------------------------------------------------
reload:
	wiiload -r $(OUTPUT).dol

#---------------------------------------------------------------------------------
else

DEPENDS	:=	$(OFILES:.o=.d)

#---------------------------------------------------------------------------------
# main targets
#---------------------------------------------------------------------------------
$(OUTPUT).dol: $(OUTPUT).elf
$(OUTPUT).elf: $(OFILES)

#---------------------------------------------------------------------------------
# This rule links in binary data with .ttf, .lang, .png, and .jpg extensions
#---------------------------------------------------------------------------------
%.ttf.o : %.ttf
	@echo $(notdir $<)
	$(bin2o)

%.lang.o : %.lang
	@echo $(notdir $<)
	$(bin2o)

%.png.o : %.png
	@echo $(notdir $<)
	$(bin2o)

%.jpg.o : %.jpg
	@echo $(notdir $<)
	$(bin2o)

-include $(DEPENDS)

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
